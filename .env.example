SESSION_SECRET=generate_a_random_string_here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://pun.loomskullcap.com/auth/google/callback
GEMINI_API_KEY=your_gemini_api_key
# Model the backup pun judge uses when the primary judge hits its daily quota (HTTP 429)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
UMAMI_BASE_URL=http://umami:3000

# Loom & Skullcap hub integration (see docs/guides/05-hub-integration.md in
# the loom-skullcap repo). HUB_GAME_ID and HUB_API_SECRET come from the hub's
# `apps` table after seeding; HUB_JWT_SECRET must match the hub's JWT_SECRET.
HUB_URL=https://loomskullcap.com
HUB_GAME_ID=
HUB_API_SECRET=
HUB_JWT_SECRET=
HUB_SESSION_COOKIE_DOMAIN=.loomskullcap.com
